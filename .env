# Copy this file to ".env" and fill in your real values. Never commit ".env".

# ---- Server ----
PORT=3000

# Signs login sessions. Make this a long random string - anyone who has it
# could forge logins, so treat it like a master password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=305e177dc0ca8bd286da4b66d232706ffc6801d5887597ca026a01297d91944c

# The very first admin account, created automatically the first time the
# server starts with an empty database. After that, create further admin
# and scanner accounts from the Team tab in the app - these two values are
# only used once, for bootstrapping, and can be left as-is afterward
# (they're ignored once at least one account already exists).
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=shubh@11

# ---- SMTP (email sending) ----
# Default values below are set up for Office365/Outlook.
# For Gmail instead, use:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=goelshubhansh@gmail.com
SMTP_PASS=jhtsqeuyjdwdwnzy


# What shows as the "From" name on emails
SMTP_FROM_NAME=SEE Dept.

# ---- Event ----
# Only used to name the very first event, auto-created on first run.
EVENT_NAME=Freshers
