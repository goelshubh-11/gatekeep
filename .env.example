# Copy this file to ".env" and fill in your real values. Never commit ".env".

# ---- Server ----
PORT=3000

# Signs login sessions. Make this a long random string - anyone who has it
# could forge logins, so treat it like a master password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# The very first admin account, created automatically the first time the
# server starts with an empty database. After that, create further admin
# and scanner accounts from the Team tab in the app - these two values are
# only used once, for bootstrapping, and can be left as-is afterward
# (they're ignored once at least one account already exists).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ---- SMTP (email sending) ----
# Default values below are set up for Office365/Outlook.
# For Gmail instead, use:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=youraccount@gmail.com
#   SMTP_PASS=your-16-character-gmail-app-password (no spaces)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
# The mailbox that will send confirmation emails, e.g. events@college.edu
SMTP_USER=your-college-mailbox@college.edu
# The App Password generated for this mailbox (see README - NOT your normal login password)
SMTP_PASS=your-app-password

# What shows as the "From" name on emails
SMTP_FROM_NAME=College Event Team

# ---- Event ----
# Only used to name the very first event, auto-created on first run.
EVENT_NAME=Your Event Name Here
